{
  "openapi": "3.0.3",
  "info": {"title": "T100 伴随助手局域网接口", "version": "0.5.0", "description": "电脑上传同名 .tif + .tfw 处方图文件对，或下发清单同步与作业准备命令。作业准备只选择本地作业和处方图并停在待执行页面；危险飞行、锁定和任务执行动作会被拦截。"},
  "servers": [{"url": "http://{host}:8787", "variables": {"host": {"default": "127.0.0.1", "description": "服务端局域网 IPv4 地址"}}}],
  "tags": [{"name":"Admin","description":"成熟系统/控制台接口"},{"name":"Device","description":"Android 伴随 App 接口"},{"name":"System"}],
  "paths": {
    "/api/health": {"get":{"tags":["System"],"summary":"服务健康检查","responses":{"200":{"description":"正常","content":{"application/json":{"schema":{"type":"object"}}}}}}},
    "/api/admin/commands": {
      "post":{"tags":["Admin"],"summary":"发布命令","security":[{"AdminKey":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateCommand"},"examples":{"openDeviceTab":{"value":{"deviceId":"rc-t100-001","type":"CLICK_TEXT","payload":{"text":"设备"}}}}}}},"responses":{"201":{"description":"已进入队列","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommandRecord"}}}},"400":{"description":"参数错误"},"401":{"description":"管理密钥错误"},"409":{"description":"IMPORT_PRESCRIPTION 时设备尚未确认 SD 卡文件对就绪"}}},
      "get":{"tags":["Admin"],"summary":"查询命令记录","security":[{"AdminKey":[]}],"parameters":[{"name":"deviceId","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"记录列表","content":{"application/json":{"schema":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/CommandRecord"}}}}}}}}}
    },
    "/api/admin/commands/{commandId}": {"get":{"tags":["Admin"],"summary":"查询单条命令","security":[{"AdminKey":[]}],"parameters":[{"$ref":"#/components/parameters/CommandId"}],"responses":{"200":{"description":"命令详情","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommandRecord"}}}},"404":{"description":"不存在"}}}},
    "/api/admin/prescriptions/{fileName}": {"put":{"tags":["Admin"],"summary":"上传处方图文件对并下发到遥控器","description":"使用同一个 pairId 分别上传基础名称完全一致的 .tif 和 .tfw。每个请求体最大 1 GiB，采用流式接收并计算 SHA-256；收齐两份后才创建 DOWNLOAD_PRESCRIPTION 命令。","security":[{"AdminKey":[]}],"parameters":[{"name":"fileName","in":"path","required":true,"schema":{"type":"string","pattern":"(?i)\\.(tif|tfw)$"}},{"name":"deviceId","in":"query","required":true,"schema":{"type":"string"}},{"name":"pairId","in":"query","required":true,"schema":{"type":"string","minLength":8,"maxLength":80}}],"requestBody":{"required":true,"content":{"application/octet-stream":{"schema":{"type":"string","format":"binary"}}}},"responses":{"201":{"description":"文件对已收齐并排队成功","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PrescriptionUpload"}}}},"202":{"description":"已接收一份，等待配对文件"},"400":{"description":"文件名、格式、配对名称或设备编号无效"},"409":{"description":"同一配对中重复上传同一扩展名"},"413":{"description":"单个文件超过 1 GiB"}}}},
    "/api/admin/devices": {"get":{"tags":["Admin"],"summary":"查看设备在线及功能状态","security":[{"AdminKey":[]}],"responses":{"200":{"description":"设备列表；15 秒无心跳视为离线","content":{"application/json":{"schema":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/DeviceStatus"}},"onlineTimeoutSeconds":{"type":"integer"}}}}}}}}},
    "/api/admin/agras-inventory": {"get":{"tags":["Admin"],"summary":"查询设备上报的 Agras 作业与已导入处方图列表","security":[{"AdminKey":[]}],"parameters":[{"name":"deviceId","in":"query","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"设备清单或空清单"}}}},
    "/api/admin/job-bindings": {"get":{"tags":["Admin"],"summary":"查询作业与处方图关联","security":[{"AdminKey":[]}],"responses":{"200":{"description":"关联列表"}}},"post":{"tags":["Admin"],"summary":"保存作业与处方图关联","security":[{"AdminKey":[]}],"responses":{"201":{"description":"关联已保存"},"400":{"description":"缺少必要字段"}}}},
    "/api/device/agras-inventory": {"post":{"tags":["Device"],"summary":"伴随 App 上报 Agras 作业与已导入处方图列表","security":[{"DeviceBearer":[]}],"responses":{"200":{"description":"清单已记录"}}}},
    "/api/device/telemetry": {"post":{"tags":["Device"],"summary":"上报飞机实时遥测点","description":"由授权 DJI SDK 或云端遥测适配器上报真实位置；伴随 App 不应伪造坐标。","security":[{"DeviceBearer":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TelemetryPoint"}}}},"responses":{"200":{"description":"遥测点已保存"},"400":{"description":"坐标超出范围"}}}},
    "/api/admin/telemetry": {"get":{"tags":["Admin"],"summary":"读取设备最近实时轨迹","security":[{"AdminKey":[]}],"parameters":[{"name":"deviceId","in":"query","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"最近 2000 个遥测点"}}}},
    "/api/device/status": {"post":{"tags":["Device"],"summary":"伴随 App 上报状态心跳","security":[{"DeviceBearer":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeviceStatusReport"}}}},"responses":{"200":{"description":"已记录状态"},"401":{"description":"设备令牌错误"}}}},
    "/api/device/prescriptions/{prescriptionId}/{fileName}": {"get":{"tags":["Device"],"summary":"遥控器下载处方图中的指定文件","security":[{"DeviceBearer":[]}],"parameters":[{"name":"prescriptionId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"fileName","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"原始 TIF 或 TFW 文件","headers":{"X-Content-SHA256":{"schema":{"type":"string"}}},"content":{"application/octet-stream":{"schema":{"type":"string","format":"binary"}}}},"404":{"description":"文件不存在"}}}},
    "/api/device/commands/next": {"get":{"tags":["Device"],"summary":"设备获取下一条命令","security":[{"DeviceBearer":[]}],"parameters":[{"name":"deviceId","in":"query","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"待执行命令","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeviceCommand"}}}},"204":{"description":"暂无命令"},"401":{"description":"设备令牌错误"}}}},
    "/api/device/commands/{commandId}/ack": {"post":{"tags":["Device"],"summary":"设备回传执行结果","security":[{"DeviceBearer":[]}],"parameters":[{"$ref":"#/components/parameters/CommandId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Ack"}}}},"responses":{"200":{"description":"已接收","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommandRecord"}}}},"404":{"description":"命令不存在"}}}}
  },
  "components": {
    "securitySchemes":{"AdminKey":{"type":"apiKey","in":"header","name":"X-Admin-Key"},"DeviceBearer":{"type":"http","scheme":"bearer","bearerFormat":"opaque-device-token"}},
    "parameters":{"CommandId":{"name":"commandId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}},
    "schemas": {
      "CreateCommand":{"type":"object","required":["deviceId","type"],"properties":{"deviceId":{"type":"string"},"type":{"type":"string","enum":["OPEN_DJI","OPEN_AGRAS","OPEN_APP","OPEN_DEEPLINK","INSPECT_PAGE","IMPORT_PRESCRIPTION","READ_AGRAS_INVENTORY","PREPARE_AGRAS_JOB","READ_AGRAS_RTK_STATUS","CLICK_TEXT","CLICK_ID","CLICK_RATIO","WAIT_PAGE","BACK"]},"payload":{"$ref":"#/components/schemas/CommandPayload"}}},
      "CommandPayload":{"type":"object","description":"app 可为 agras、smartfarm 或对应包名，省略时默认 Agras。IMPORT_PRESCRIPTION 要求 fileName。PREPARE_AGRAS_JOB 要求设备同步清单中存在的 jobName 和 prescriptionName，且只准备到待执行状态。CLICK_TEXT 使用 text；CLICK_ID 使用 resourceId；CLICK_RATIO 使用 0..1 的 x/y。","properties":{"app":{"type":"string","enum":["agras","smartfarm","com.dji.agrasx","com.dji.agflow"],"default":"agras"},"uri":{"type":"string","pattern":"^agworkflow://"},"text":{"type":"string"},"resourceId":{"type":"string"},"fileName":{"type":"string"},"jobName":{"type":"string"},"prescriptionName":{"type":"string"},"entryText":{"type":"string","default":"导入"},"source":{"type":"string","enum":["dji","other"],"default":"dji"},"unit":{"type":"string","enum":["mu","ha"],"default":"mu"},"resample":{"type":"string","enum":["max","average"],"default":"average"},"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"description":{"type":"string"},"timeoutMs":{"type":"integer","minimum":0,"maximum":60000,"default":10000}},"additionalProperties":false},
      "DeviceCommand":{"type":"object","required":["id","type","payload"],"properties":{"id":{"type":"string","format":"uuid"},"type":{"type":"string"},"payload":{"type":"object","additionalProperties":true}}},
      "Ack":{"type":"object","required":["success","message"],"properties":{"success":{"type":"boolean"},"message":{"type":"string"}}},
      "PrescriptionFile":{"type":"object","properties":{"fileName":{"type":"string"},"size":{"type":"integer"},"sha256":{"type":"string"}}},
      "PrescriptionUpload":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"pairId":{"type":"string"},"baseName":{"type":"string"},"files":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/components/schemas/PrescriptionFile"}},"commandId":{"type":"string","format":"uuid"}}},
      "DeviceStatusReport":{"type":"object","required":["deviceId"],"properties":{"deviceId":{"type":"string"},"foregroundService":{"type":"boolean"},"accessibilityEnabled":{"type":"boolean"},"accessibilityConnected":{"type":"boolean","description":"无障碍服务实例当前已绑定运行"},"agrasInstalled":{"type":"boolean"},"sdCardInserted":{"type":"boolean","description":"检测到已挂载的可移除 SD 卡"},"sdCardWritable":{"type":"boolean","description":"可创建并写入 SD 卡根目录 DJI/RX/"},"prescriptionImportReady":{"type":"boolean","description":"SD 卡中存在最近下发且校验通过的同名 TIF/TFW 文件对"},"companionVersion":{"type":"string"},"androidVersion":{"type":"string"}}},
      "TelemetryPoint":{"type":"object","required":["deviceId","latitude","longitude"],"properties":{"deviceId":{"type":"string"},"latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180},"altitude":{"type":"number"},"speed":{"type":"number"},"heading":{"type":"number"},"isFlying":{"type":"boolean"},"source":{"type":"string"}}},
      "DeviceStatus":{"allOf":[{"$ref":"#/components/schemas/DeviceStatusReport"},{"type":"object","properties":{"sdCardStatusReported":{"type":"boolean","description":"新版伴随 App 是否已上报 SD 卡字段"},"online":{"type":"boolean"},"lastSeen":{"type":"string","format":"date-time"},"remoteAddress":{"type":"string"}}}]},
      "CommandRecord":{"allOf":[{"$ref":"#/components/schemas/DeviceCommand"},{"type":"object","properties":{"deviceId":{"type":"string"},"status":{"type":"string","enum":["QUEUED","DELIVERED","SUCCEEDED","FAILED"]},"createdAt":{"type":"string","format":"date-time"},"deliveredAt":{"type":"string","format":"date-time"},"acknowledgedAt":{"type":"string","format":"date-time"},"success":{"type":"boolean"},"message":{"type":"string"}}}]}
    }
  }
}
