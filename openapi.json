{
  "openapi": "3.0.3",
  "info": {"title": "T100 伴随助手局域网接口", "version": "0.3.0", "description": "电脑上传处方图或发布安全导航命令，Android 伴随 App 下载到遥控器并控制 DJI Agras 导入页面。危险飞行、锁定和作业动作会被拦截。"},
  "servers": [{"url": "http://{host}:8787", "variables": {"host": {"default": "127.0.0.1", "description": "服务端局域网 IPv4 地址"}}}],
  "tags": [{"name":"Admin","description":"成熟系统/控制台接口"},{"name":"Device","description":"Android 伴随 App 接口"},{"name":"System"}],
  "paths": {
    "/api/health": {"get":{"tags":["System"],"summary":"服务健康检查","responses":{"200":{"description":"正常","content":{"application/json":{"schema":{"type":"object"}}}}}}},
    "/api/admin/commands": {
      "post":{"tags":["Admin"],"summary":"发布命令","security":[{"AdminKey":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateCommand"},"examples":{"openDeviceTab":{"value":{"deviceId":"rc-t100-001","type":"CLICK_TEXT","payload":{"text":"设备"}}}}}}},"responses":{"201":{"description":"已进入队列","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommandRecord"}}}},"400":{"description":"参数错误"},"401":{"description":"管理密钥错误"}}},
      "get":{"tags":["Admin"],"summary":"查询命令记录","security":[{"AdminKey":[]}],"parameters":[{"name":"deviceId","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"记录列表","content":{"application/json":{"schema":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/CommandRecord"}}}}}}}}}
    },
    "/api/admin/commands/{commandId}": {"get":{"tags":["Admin"],"summary":"查询单条命令","security":[{"AdminKey":[]}],"parameters":[{"$ref":"#/components/parameters/CommandId"}],"responses":{"200":{"description":"命令详情","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommandRecord"}}}},"404":{"description":"不存在"}}}},
    "/api/admin/prescriptions/{fileName}": {"put":{"tags":["Admin"],"summary":"上传处方图并下发到遥控器","description":"请求体是原始文件内容，最大 64 MiB。成功后自动创建 DOWNLOAD_PRESCRIPTION 命令。","security":[{"AdminKey":[]}],"parameters":[{"name":"fileName","in":"path","required":true,"schema":{"type":"string"}},{"name":"deviceId","in":"query","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/octet-stream":{"schema":{"type":"string","format":"binary"}}}},"responses":{"201":{"description":"上传并排队成功","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PrescriptionUpload"}}}},"400":{"description":"文件名或设备编号无效"},"413":{"description":"文件超过限制"}}}},
    "/api/admin/devices": {"get":{"tags":["Admin"],"summary":"查看设备在线及功能状态","security":[{"AdminKey":[]}],"responses":{"200":{"description":"设备列表；15 秒无心跳视为离线","content":{"application/json":{"schema":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/DeviceStatus"}},"onlineTimeoutSeconds":{"type":"integer"}}}}}}}}},
    "/api/device/status": {"post":{"tags":["Device"],"summary":"伴随 App 上报状态心跳","security":[{"DeviceBearer":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeviceStatusReport"}}}},"responses":{"200":{"description":"已记录状态"},"401":{"description":"设备令牌错误"}}}},
    "/api/device/prescriptions/{prescriptionId}": {"get":{"tags":["Device"],"summary":"遥控器下载处方图","security":[{"DeviceBearer":[]}],"parameters":[{"name":"prescriptionId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"原始处方图文件","headers":{"X-Content-SHA256":{"schema":{"type":"string"}}},"content":{"application/octet-stream":{"schema":{"type":"string","format":"binary"}}}},"404":{"description":"文件不存在"}}}},
    "/api/device/commands/next": {"get":{"tags":["Device"],"summary":"设备获取下一条命令","security":[{"DeviceBearer":[]}],"parameters":[{"name":"deviceId","in":"query","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"待执行命令","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeviceCommand"}}}},"204":{"description":"暂无命令"},"401":{"description":"设备令牌错误"}}}},
    "/api/device/commands/{commandId}/ack": {"post":{"tags":["Device"],"summary":"设备回传执行结果","security":[{"DeviceBearer":[]}],"parameters":[{"$ref":"#/components/parameters/CommandId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Ack"}}}},"responses":{"200":{"description":"已接收","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommandRecord"}}}},"404":{"description":"命令不存在"}}}}
  },
  "components": {
    "securitySchemes":{"AdminKey":{"type":"apiKey","in":"header","name":"X-Admin-Key"},"DeviceBearer":{"type":"http","scheme":"bearer","bearerFormat":"opaque-device-token"}},
    "parameters":{"CommandId":{"name":"commandId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}},
    "schemas": {
      "CreateCommand":{"type":"object","required":["deviceId","type"],"properties":{"deviceId":{"type":"string"},"type":{"type":"string","enum":["OPEN_DJI","OPEN_AGRAS","OPEN_APP","OPEN_DEEPLINK","INSPECT_PAGE","IMPORT_PRESCRIPTION","CLICK_TEXT","CLICK_ID","CLICK_RATIO","WAIT_PAGE","BACK"]},"payload":{"$ref":"#/components/schemas/CommandPayload"}}},
      "CommandPayload":{"type":"object","description":"app 可为 agras、smartfarm 或对应包名，省略时默认 Agras。IMPORT_PRESCRIPTION 要求 fileName，可配置 entryText、source、unit、resample。CLICK_TEXT 使用 text；CLICK_ID 使用 resourceId；CLICK_RATIO 使用 0..1 的 x/y。","properties":{"app":{"type":"string","enum":["agras","smartfarm","com.dji.agrasx","com.dji.agflow"],"default":"agras"},"uri":{"type":"string","pattern":"^agworkflow://"},"text":{"type":"string"},"resourceId":{"type":"string"},"fileName":{"type":"string"},"entryText":{"type":"string","default":"导入"},"source":{"type":"string","enum":["dji","other"],"default":"dji"},"unit":{"type":"string","enum":["mu","ha"],"default":"mu"},"resample":{"type":"string","enum":["max","average"],"default":"max"},"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"description":{"type":"string"},"timeoutMs":{"type":"integer","minimum":0,"maximum":60000,"default":10000}},"additionalProperties":false},
      "DeviceCommand":{"type":"object","required":["id","type","payload"],"properties":{"id":{"type":"string","format":"uuid"},"type":{"type":"string"},"payload":{"type":"object","additionalProperties":true}}},
      "Ack":{"type":"object","required":["success","message"],"properties":{"success":{"type":"boolean"},"message":{"type":"string"}}},
      "PrescriptionUpload":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"fileName":{"type":"string"},"size":{"type":"integer"},"sha256":{"type":"string"},"commandId":{"type":"string","format":"uuid"}}},
      "DeviceStatusReport":{"type":"object","required":["deviceId"],"properties":{"deviceId":{"type":"string"},"foregroundService":{"type":"boolean"},"accessibilityEnabled":{"type":"boolean"},"agrasInstalled":{"type":"boolean"},"companionVersion":{"type":"string"},"androidVersion":{"type":"string"}}},
      "DeviceStatus":{"allOf":[{"$ref":"#/components/schemas/DeviceStatusReport"},{"type":"object","properties":{"online":{"type":"boolean"},"lastSeen":{"type":"string","format":"date-time"},"remoteAddress":{"type":"string"}}}]},
      "CommandRecord":{"allOf":[{"$ref":"#/components/schemas/DeviceCommand"},{"type":"object","properties":{"deviceId":{"type":"string"},"status":{"type":"string","enum":["QUEUED","DELIVERED","SUCCEEDED","FAILED"]},"createdAt":{"type":"string","format":"date-time"},"deliveredAt":{"type":"string","format":"date-time"},"acknowledgedAt":{"type":"string","format":"date-time"},"success":{"type":"boolean"},"message":{"type":"string"}}}]}
    }
  }
}
